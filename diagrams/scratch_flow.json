{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Notebook 01: one question through hand-made RAG",
    "output": "diagrams/scratch_flow.html",
    "quality_profile": "showcase",
    "locale": "en"
  },
  "participants": [
    {
      "id": "nb",
      "type": "frontend",
      "label": "Your notebook",
      "sublabel": "question"
    },
    {
      "id": "scratch",
      "type": "backend",
      "label": "raglab.scratch",
      "sublabel": "numpy"
    },
    {
      "id": "emb",
      "type": "cloud",
      "label": "Embeddings API",
      "sublabel": "text-embedding-3-small"
    },
    {
      "id": "chat",
      "type": "cloud",
      "label": "Chat API",
      "sublabel": "gpt-6-luna"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 255,
      "label": "Index (once)"
    },
    {
      "from": 265,
      "to": 385,
      "label": "Retrieve"
    },
    {
      "from": 390,
      "to": 485,
      "label": "Generate"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "nb",
      "to": "scratch",
      "y": 170,
      "label": "answer(question, passages)",
      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "scratch",
      "to": "emb",
      "y": 205,
      "label": "embed 8 passages",
      "variant": "default"
    },
    {
      "id": "m3",
      "from": "emb",
      "to": "scratch",
      "y": 240,
      "label": "8 vectors (cached)",
      "variant": "return"
    },
    {
      "id": "m4",
      "from": "scratch",
      "to": "emb",
      "y": 285,
      "label": "embed question",
      "variant": "default"
    },
    {
      "id": "m5",
      "from": "emb",
      "to": "scratch",
      "y": 320,
      "label": "1 vector",
      "variant": "return",
      "note": "cosine similarity, keep top 3"
    },
    {
      "id": "m6",
      "from": "scratch",
      "to": "chat",
      "y": 400,
      "label": "prompt: passages + question",
      "variant": "emphasis"
    },
    {
      "id": "m7",
      "from": "chat",
      "to": "scratch",
      "y": 435,
      "label": "answer text",
      "variant": "return"
    },
    {
      "id": "m8",
      "from": "scratch",
      "to": "nb",
      "y": 470,
      "label": "answer, contexts, scores",
      "variant": "return"
    }
  ]
}
