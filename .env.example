# Copy this file to .env and fill in your key. .env is git-ignored.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: chat model. Default gpt-6-luna (cheap, current). gpt-5.4-mini is a faster alternative.
# RAGLAB_CHAT_MODEL=gpt-6-luna

# Optional: "chroma" (default, local files) or "pgvector" (needs DATABASE_URL)
# RAGLAB_STORE=chroma

# Optional: Postgres with the pgvector extension, e.g. a free Neon project (notebook 09, service deploy)
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Optional: set to 1 to re-run the full (more expensive) evaluations and save them to results/
# RAGLAB_FULL_RUN=0

# Optional: API key clients must send in the X-API-Key header to the FastAPI service (notebook 11)
# RAGLAB_SERVICE_API_KEY=change-me

# Optional: public git URL of this repo, used by Colab/Kaggle setup cells to clone it
# RAGLAB_REPO_URL=https://github.com/<you>/RAG-lab
